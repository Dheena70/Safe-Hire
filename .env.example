# ============================================================================
# SAFE HIRE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production values
# DO NOT commit .env containing real production secrets to version control!
# ============================================================================

# Flask Application Environment (development / production)
FLASK_ENV=production
DEBUG=False

# Server Host & Port
PORT=5050
HOST=0.0.0.0

# JWT Authentication Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Comma-separated list of Administrator email addresses
ADMIN_EMAILS=rdheena0509@gmail.com

# Comma-separated list of allowed CORS origins (leave * or specific frontend domains)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://safe-hire.onrender.com

# Rate Limiting Configuration (requests per minute)
RATE_LIMIT_AUTH=5
RATE_LIMIT_PREDICT=30
RATE_LIMIT_GENERAL=60
